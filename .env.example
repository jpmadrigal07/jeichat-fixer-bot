JEICHAT_BOT_TOKEN=jei_live_your_token_here
JEICHAT_API_URL=http://localhost:3001
JEICHAT_WEB_ORIGIN=http://localhost:3000

# Checker bot's userId from GET /bots/@me on the checker process (optional but recommended)
# CHECKER_BOT_USER_ID=

# Cursor Dashboard → Integrations (user API key) or Team → Service accounts
CURSOR_API_KEY=cursor_your_key_here

# cloud = Cursor-hosted VM clones CURSOR_REPO_URL and opens a PR
# That Cursor account must have GitHub access to clone and open PRs on the repo.
CURSOR_RUNTIME=cloud
CURSOR_REPO_URL=https://github.com/jpmadrigal07/jeichat
CURSOR_REPO_REF=main
CURSOR_MODEL=composer-2.5

# local = agent loop on this machine (needs a checkout of jeichat)
# CURSOR_RUNTIME=local
# CURSOR_REPO_PATH=C:\zkript-solutions\in-house\jeichat
